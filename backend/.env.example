# Copy to backend/.env for local development. Keep real secrets out of Git.
APP_ENV=development
# Optional in development; required in production.
# API_KEY=replace-with-a-unique-production-key
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas is the source of truth for submission and review metadata.
# Add the Atlas application connection string to backend/.env.
MONGODB_URI=
MONGODB_DATABASE=terabox
# Uploaded originals remain in this directory until object storage is configured.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20
MAX_TEXT_CHARS=2000000

# Local Hugging Face model weights are downloaded on first use; no Inference API
# credits are used. ENABLE_SEMANTIC enables local CPU embeddings.
ENABLE_SEMANTIC=false
ALLOW_EXTERNAL_AI=false # gates Groq calls, not local embeddings
HF_TOKEN= # optional Hub token for model downloads/rate limits
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Groq explanations and the PydanticAI tool-using agent are gated by
# ALLOW_EXTERNAL_AI=true. Setting this sends selected evidence to Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# PydanticAI tool-using review agent.
AGENT_ENABLED=true
AGENT_MODEL=groq:openai/gpt-oss-120b
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_CALLS=6

# Vector persistence uses Qdrant. Set VECTOR_STORE=none to disable it.
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=passage_embeddings

# Public web comparison is opt-in; it sends a short text excerpt to Tavily.
ALLOW_EXTERNAL_SEARCH=false
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Optional text AI/plagiarism providers. Enable only when you consent to send
# submitted text to these services; keys are never required to start the API.
ALLOW_EXTERNAL_DETECTORS=false
SAPLING_API_KEY=
PLAGIARISMCHECK_API_KEY=

# Dolos is a public code-analysis service; code leaves this server when enabled.
ALLOW_EXTERNAL_CODE_CHECK=false
DOLOS_API_URL=https://dolos.ugent.be/api

# Local-only agent diagnostics; no Logfire/hosted telemetry is enabled.
