# Copy to backend/.env for local development. Keep real secrets out of Git.
APP_ENV=development
API_KEY=dev-key-change-this
CORS_ORIGINS=http://localhost:3000

# Local durable metadata, analysis results, and original uploads.
DB_PATH=./data/terabox.sqlite3
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20
MAX_TEXT_CHARS=2000000

# Hosted Hugging Face embedding. Disabled unless both flags are enabled.
ENABLE_SEMANTIC=false
ALLOW_EXTERNAL_AI=false
HF_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Groq explanations and the PydanticAI tool-using agent are gated by
# ALLOW_EXTERNAL_AI=true. Setting this sends selected evidence to Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# PydanticAI tool-using review agent.
AGENT_ENABLED=true
AGENT_MODEL=groq:openai/gpt-oss-120b
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_CALLS=6

# Vector persistence uses Qdrant. Set VECTOR_STORE=none to disable it.
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=passage_embeddings

# Public web comparison is opt-in; it sends a short text excerpt to Tavily.
ALLOW_EXTERNAL_SEARCH=false
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Local-only agent diagnostics; no Logfire/hosted telemetry is enabled.
